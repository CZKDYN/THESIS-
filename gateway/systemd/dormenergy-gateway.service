[Unit]
Description=DormEnergy monitoring MQTT to HTTPS gateway
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target mosquitto.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=dormenergy-gateway
Group=dormenergy-gateway
WorkingDirectory=/opt/dormenergy/THESIS-
ExecStart=/opt/dormenergy/THESIS-/gateway/.venv/bin/dormenergy-gateway run --config /etc/dormenergy-gateway/config.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=75
UMask=0077
StateDirectory=dormenergy-gateway
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/dormenergy-gateway
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
