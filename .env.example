# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-development-secret
DATABASE_URL=postgresql+psycopg://dormenergy:change-me@localhost:5432/dormenergy
SIMULATION_MODE=false
SESSION_COOKIE_SECURE=false
LOW_BALANCE_THRESHOLD=100.00
# Only set true behind HTTPS in production.
# Needed only to create the first administrator on an empty database.
# Set a random token securely and enter it at /setup; never commit its value.
ADMIN_SETUP_TOKEN=

# Email delivery is opt-in. Configure these securely in Render; never commit keys.
EMAIL_BACKEND=disabled
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_BASE_URL=
# Recommended: a dedicated Fernet key, generated once and kept stable.
# If blank, the outbox key is derived from SECRET_KEY; keep that key stable.
EMAIL_ENCRYPTION_KEY=
EMAIL_ACTIVATION_HOURS=24
EMAIL_RESET_MINUTES=30
EMAIL_RESEND_COOLDOWN=60
EMAIL_MAX_ATTEMPTS=6
EMAIL_CREDIT_EXHAUSTION=false
# Local test mailbox only: EMAIL_BACKEND=memory and ALLOW_TEST_EMAIL=true.
ALLOW_TEST_EMAIL=false
